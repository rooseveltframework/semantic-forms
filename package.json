{
  "name": "semantic-forms",
  "description": "🎯 A pattern library of forms based on semantic HTML enhanced with a modern UX.",
  "author": "Roosevelt Framework Team <rooseveltframework@gmail.com>",
  "contributors": [
    {
      "name": "Contributors",
      "url": "https://github.com/rooseveltframework/semantic-forms/graphs/contributors"
    }
  ],
  "version": "5.3.11",
  "files": [
    "dist",
    "semanticForms.scss",
    "docs/statics",
    "*.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/semantic-forms.mjs",
      "require": "./dist/semantic-forms.cjs"
    },
    "./min": {
      "default": "./dist/semantic-forms.min.mjs"
    }
  },
  "homepage": "https://rooseveltframework.org/docs/semantic-forms/latest",
  "license": "CC-BY-4.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "semanticForms.js",
  "readmeFilename": "README.md",
  "devDependencies": {
    "@jsdevtools/coverage-istanbul-loader": "3.0.5",
    "@playwright/test": "1.63.0",
    "eslint-plugin-html": "8.2.1",
    "nyc": "18.0.0",
    "sass": "1.105.0",
    "standard": "17.1.2",
    "terser-webpack-plugin": "5.6.1",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "webpack && sass semanticForms.scss dist/semantic-forms.css",
    "watch": "webpack && sass --watch semanticForms.scss dist/semantic-forms.css",
    "d": "node --watch-path=semanticForms.js --watch-path=lib --watch-path=semanticForms.scss --watch-path=styles --watch-path=docs/statics dev-server.js",
    "dev": "node --watch-path=semanticForms.js --watch-path=lib --watch-path=semanticForms.scss --watch-path=styles --watch-path=docs/statics dev-server.js",
    "development": "node --watch-path=semanticForms.js --watch-path=lib --watch-path=semanticForms.scss --watch-path=styles --watch-path=docs/statics dev-server.js",
    "lint": "standard && standard --plugin html docs/statics/pages/*.html",
    "lint-fix": "standard --fix && standard --plugin html docs/statics/pages/*.html --fix",
    "test": "npm run build && playwright test",
    "test-visual": "playwright test --config=playwright.visual.config.js",
    "test-visual-docker": "node visual-tests.js",
    "coverage": "webpack --env coverage && sass semanticForms.scss dist/semantic-forms.css && nyc playwright test && npm run build"
  },
  "standard": {
    "ignore": [
      "dist/",
      "docs/public"
    ]
  },
  "nyc": {
    "include": [
      "semanticForms.js",
      "lib/**/*.js"
    ],
    "reporter": [
      "text",
      "html"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/rooseveltframework/semantic-forms.git"
  },
  "keywords": [
    "semantic",
    "forms",
    "float",
    "label"
  ],
  "funding": "https://www.paypal.com/donate/?hosted_button_id=2L2X8GRXZCGJ6"
}
